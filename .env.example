# Reserved for the planned exercise correction backend (PM-BE-01).
# No code in src/ reads these values yet. Keep this file committed, keep real keys in .env.local.

# Use the local mock corrector (recommended for dev). Set to any other value to use the real provider.
MOCK_CORRECTOR=true

# API key for the Anthropic SDK. Required only when MOCK_CORRECTOR is not "true".
ANTHROPIC_API_KEY=
